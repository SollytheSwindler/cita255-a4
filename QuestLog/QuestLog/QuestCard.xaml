<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="QuestLog.QuestCard">
    <Grid ColumnDefinitions="*, Auto" Padding="12">
        <HorizontalStackLayout>
            <Label Text="{Binding Title}" FontSize="16" Padding="12,10" />
            <Label Text="{Binding Giver}" FontSize="16" Padding="12,10" />
            <Label Text="{Binding Reward}" FontSize="16" Padding="12,10" />
        </HorizontalStackLayout>
    </Grid>
</ContentView>
